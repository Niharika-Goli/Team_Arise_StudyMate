import os
import pdfplumber
import gradio as gr
import faiss
import numpy as np
from sentence_transformers import SentenceTransformer
from transformers import pipeline


# =============================
# 3️⃣ 🔑 PLACE YOUR HF TOKEN HERE
# =============================
os.environ["HF_TOKEN"] = "PASTE_YOUR_HUGGINGFACE_API_KEY_HERE"

if os.environ["HF_TOKEN"] == "PASTE_YOUR_HUGGINGFACE_API_KEY_HERE":
    print("⚠️ ERROR: You must paste your HuggingFace token in the code!")
else:
    print("✅ HF Token Loaded")


# =============================
# 4️⃣ Load Embedding Model
# =============================
embedder = SentenceTransformer("sentence-transformers/all-MiniLM-L6-v2")

# =============================
# 5️⃣ Load LLM (Flan-T5)
# =============================
llm = pipeline(
    "text2text-generation",
    model="google/flan-t5-large",
    token=os.environ["HF_TOKEN"]
)


# =====================================================================
# 6️⃣ PDF TEXT EXTRACTION
# =====================================================================
def extract_text_from_pdfs(pdf_files):
    text = ""
    for pdf in pdf_files:
        try:
            with pdfplumber.open(pdf.name) as p:
                for page in p.pages:
                    text += page.extract_text() or ""
        except:
            return None
    return text if text.strip() != "" else None


# =====================================================================
# 7️⃣ CHUNKING FUNCTION
# =====================================================================
def chunk_text(text, chunk_size=300):
    sentences = text.split(". ")
    chunks, current = [], ""

    for s in sentences:
        if len(current) + len(s) <= chunk_size:
            current += s + ". "
        else:
            chunks.append(current.strip())
            current = s + ". "

    if current:
        chunks.append(current.strip())

    return chunks


# =====================================================================
# 8️⃣ GLOBALS FOR VECTORSTORE
# =====================================================================
chunks_global = []
embeddings_global = None
index_global = None


# =====================================================================
# 9️⃣ PROCESS PDF FUNCTION
# =====================================================================
def process_pdfs(pdf_files):
    global chunks_global, embeddings_global, index_global

    if not pdf_files:
        return "No file uploaded."

    extracted = extract_text_from_pdfs(pdf_files)

    if extracted is None:
        return "❌ Error: Could not extract text. PDF may be scanned."

    chunks = chunk_text(extracted)
    embeddings = embedder.encode(chunks)

    # FAISS index
    index = faiss.IndexFlatL2(embeddings.shape[1])
    index.add(np.array(embeddings))

    # store
    chunks_global = chunks
    embeddings_global = embeddings
    index_global = index

    return f"✅ PDF processed successfully! ({len(chunks)} text chunks created)"


# =====================================================================
# 🔟 ANSWER USER QUESTION
# =====================================================================
def answer_question(question):
    global index_global, chunks_global, embeddings_global

    if index_global is None:
        return "⚠ Please upload and process a PDF first."

    q_embed = embedder.encode([question])
    D, I = index_global.search(q_embed, k=3)

    context = "\n".join([chunks_global[i] for i in I[0]])

    prompt = f"""
    You are an assistant. Use the following context to answer the question.

    CONTEXT:
    {context}

    QUESTION: {question}
    ANSWER:
    """

    response = llm(prompt, max_length=200)[0]["generated_text"]
    return response


# =====================================================================
# 1️⃣1️⃣ BUILD GRADIO UI
# =====================================================================
with gr.Blocks(title="StudyMate – PDF Q&A System") as demo:

    gr.Markdown("# 📘 StudyMate – AI PDF Q&A System")

    with gr.Row():
        pdf_in = gr.File(label="Upload PDF(s)", file_count="multiple")
        process_btn = gr.Button("Process PDFs")

    status_box = gr.Textbox(label="Status")

    question_box = gr.Textbox(label="Ask a Question")
    answer_box = gr.Textbox(label="Answer")

    process_btn.click(process_pdfs, pdf_in, status_box)
    question_box.submit(answer_question, question_box, answer_box)


# =====================================================================
# 1️⃣2️⃣ LAUNCH
# =====================================================================
demo.launch(share=True, debug=True)
